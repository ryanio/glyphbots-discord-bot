{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glyphbots-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  // No `nodejs_compat`. Nothing in the bundle imports a `node:` module: the
  // logger is `console`, Ed25519 goes through WebCrypto, and the only
  // `process.env` read in the package is in `scripts/register-commands.ts`,
  // which is not bundled. Leaving the flag off keeps that a build failure
  // rather than something that quietly starts working.
  "observability": {
    "enabled": true
  },
  // Four crons, dispatched on `event.cron` in `scheduled()` so none runs
  // another's work:
  // - `*/5 * * * *` the mint watcher (MINTS_POLL_INTERVAL_MINUTES = 5 on the
  //   Node bot, src/lib/constants.ts:46 at c75d6a8), which also pokes the
  //   gateway watchdog.
  // - `2-59/5 * * * *` the OpenSea sales feed into #trading-floor.
  // - `0 */6 * * *` a random collection item into #gallery, the cadence
  //   RANDOM_INTERVALS ran at before it stopped on 2026-05-02. Since the idle
  //   work landed this fires four times a day but posts at most once, and only
  //   when #general has been quiet for 24 hours (src/channels/gallery.ts).
  // - `23 * * * *` the idle check on #general. Hourly, and hourly is the check
  //   rate rather than the post rate: it posts only after 48 hours of silence
  //   and then at most once a day, so an ordinary day is 24 ticks and zero
  //   posts (src/channels/nudge.ts). Minute 23 is chosen to miss both
  //   five-minute entries, which land on minutes ending 0 or 5 and 2 or 7.
  //
  // The sales feed is every five minutes, not the plan's `* * * * *`. Measured
  // 2026-07-25: sales run 1.24/day, so a per-minute cron is about 1,161 empty
  // OpenSea calls per real event.
  //
  // It is minute 2, 7, 12 … rather than 0, 5, 10 … for two reasons. First,
  // `event.cron` is the only thing `scheduled()` can dispatch on, and a second
  // literal `*/5 * * * *` entry would be the same string, so the feed could not
  // be told apart from the mint tick. Second, offsetting it keeps the two ticks
  // from contending for the same subrequest budget and the same FeedStateDO
  // input gate in the same second. Same cadence, two minutes apart.
  //
  // `wrangler deploy --dry-run` does not validate these strings (tested), so
  // they are correct by inspection or not at all. Five fields each: minute,
  // hour, day of month, month, day of week.
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "2-59/5 * * * *",
      "0 */6 * * *",
      "23 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "FeedStateDO",
        "name": "FEED_STATE"
      },
      {
        "class_name": "GatewayDO",
        "name": "GATEWAY"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["FeedStateDO"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["GatewayDO"],
      "tag": "v2"
    }
  ],
  // Reserved for per-user wallet state (`wallet:<userId>`), decision 7 in
  // plans/cloudflare-consolidation.md. Provisioned so /wallet and /mybots have
  // somewhere to land later; nothing in the Worker reads or writes it today.
  "kv_namespaces": [
    {
      "binding": "GLYPHBOTS_KV",
      "id": "0f99111ce7c44f88a27ec34397745f84"
    }
  ]
  // Secrets, set with `wrangler secret put NAME` (the operator's step, not
  // something this repo configures):
  // - DISCORD_TOKEN: Oracle's bot token, used by the mint watcher
  // - DISCORD_APP_ID: Oracle's application id, part of the follow-up webhook path
  // - DISCORD_PUBLIC_KEY: Ed25519 key from the developer portal. Without it
  //   /discord/interactions answers 503 rather than trusting anything.
  // - OPENSEA_API_TOKEN: optional. Six of the eight commands read OpenSea, and
  //   unkeyed requests work but are rate limited much harder. OPENSEA_API_KEY
  //   is accepted as the same thing under OpenSea's own name for it; set
  //   either. This one is already set on the deployed script.
  //
  // - ADMIN_TOKEN: shared secret for /_admin/gateway/*, which can connect and
  //   force-reconnect the live gateway socket. Unset means those routes answer
  //   503 and do nothing; it is never an open door.
}
