{
  "name": "glyphbots-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GlyphBots Cloudflare Worker: mint, sales, gallery and idle feeds, eight slash commands, and the Discord gateway socket.",
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "dry-run": "wrangler deploy --dry-run",
    "types": "wrangler types"
  },
  "dependencies": {
    "@discordjs/builders": "^1.11.0",
    "@discordjs/rest": "^2.6.0",
    "discord-api-types": "^0.38.0",
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.90.1"
  }
}
